    UIToggleKey = Enum.KeyCode.M,
    AutoParry = {
        Range = 11,
        Lead = 0.14,
        BaseLead = 0.04,
        PingMultiplier = 2,
        MaxCompensation = 0.25,
        Hold = 0.24,
        FaceExtra = 0.08,
    },
    Fling = {
        Power = 50,
        Radius = 35,
    },
    Fly = {
        Speed = 1,
        BaseSpeed = 50,
        VerticalBoost = 2,
    },
    ShadowStep = {
        Distance = 40,
        Cooldown = 0.2,
        Key = Enum.KeyCode.Q,
    },
}

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TeleportService = game:GetService("TeleportService")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer
local heartbeat = RunService.Heartbeat
local stepped = RunService.Stepped
local renderStepped = RunService.RenderStepped

local Util = {}
Util.connections = {}

function Util.track(connection)
    table.insert(Util.connections, connection)
    return connection
end

function Util.disconnectAll()
    for i = #Util.connections, 1, -1 do
        pcall(Util.connections[i].Disconnect, Util.connections[i])
        Util.connections[i] = nil
    end
end

function Util.getChar()
    return LocalPlayer.Character
end

function Util.getRoot(char)
    char = char or LocalPlayer.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

function Util.getHumanoid(char)
    char = char or LocalPlayer.Character
    return char and char:FindFirstChildOfClass("Humanoid")
end

function Util.findPlayer(query)
    if type(query) ~= "string" or query == "" then return nil end
    query = query:lower()
    local players = Players:GetPlayers()
    for i = 1, #players do
        local p = players[i]
        if p ~= LocalPlayer then
            local name = p.Name:lower()
            local display = p.DisplayName:lower()
            if name == query or display == query or name:sub(1, #query) == query then
                return p
            end
        end
    end
    return nil
end

function Util.setVelocity(part, vel)
    if not part then return end
    pcall(function()
        part.AssemblyLinearVelocity = vel
        part.Velocity = vel
    end)
end

local Combat = { Block = nil, Config = nil, Ready = false, Fallback = false }

local function safeRequire(path)
    local node = ReplicatedStorage
    for i = 1, #path do
        node = node and node:FindFirstChild(path[i])
    end
    if not node then return nil end
    local ok, result = pcall(require, node)
    return ok and result or nil
end

function Combat.init()
    Combat.Block = safeRequire({ "CombatSystemClient", "Combat", "Base", "Block" })
    Combat.Config = safeRequire({ "Shared", "Config", "CombatConfig" })
    Combat.Ready = type(Combat.Block) == "table" and type(Combat.Block.Block) == "function" and type(Combat.Block.Unblock) == "function"
    Combat.Fallback = not Combat.Ready
    return Combat.Ready
end

function Combat.stampInput()
    local credits = _G.__GakuranAcCombatInputCreditAt
    if type(credits) ~= "table" then
        credits = {}
        _G.__GakuranAcCombatInputCreditAt = credits
    end
    credits["Block.Activated"] = tick()
end

function Combat.block()
    if Combat.Ready then
        Combat.stampInput()
        pcall(Combat.Block.Block)
        return true
    end
    local vim = game:GetService("VirtualInputManager")
    pcall(vim.SendKeyEvent, vim, true, Enum.KeyCode.F, false, game)
    return false
end

function Combat.unblock()
    if Combat.Ready then
        pcall(Combat.Block.Unblock)
        return true
    end
    local vim = game:GetService("VirtualInputManager")
    pcall(vim.SendKeyEvent, vim, false, Enum.KeyCode.F, false, game)
    return false
end

function Combat.isBlocking(char)
    return char and char:GetAttribute("Blocking") == true
end

local Veneno_Parry = {
    enabled = false,
    pingCompensation = false,
    autoFace = false,
    pulse = 0,
    smoothedPing = 0,
    attackDelays = {},
    faceBind = "Veneno_AutoFace",
    faceState = nil,
    frameCounter = 0,
}

function Veneno_Parry.startPingSampler()
    task.spawn(function()
        while true do
            local ok, ping = pcall(LocalPlayer.GetNetworkPing, LocalPlayer)
            if ok and type(ping) == "number" then
                Veneno_Parry.smoothedPing = Veneno_Parry.smoothedPing == 0 and ping or Veneno_Parry.smoothedPing + (ping - Veneno_Parry.smoothedPing) * 0.25
            end
            task.wait(0.5)
        end
    end)
end

function Veneno_Parry.lead()
    if not Veneno_Parry.pingCompensation then return CONFIG.AutoParry.Lead end
    return CONFIG.AutoParry.BaseLead + math.clamp(Veneno_Parry.smoothedPing * CONFIG.AutoParry.PingMultiplier, 0, CONFIG.AutoParry.MaxCompensation)
end

function Veneno_Parry.buildAttackTable()
    local delays = Veneno_Parry.attackDelays
    for k in pairs(delays) do delays[k] = nil end
    
    local animations = ReplicatedStorage:FindFirstChild("Animations")
    if not animations or not Combat.Config then return 0 end
    
    local count = 0
    local descendants = animations:GetDescendants()
    for i = 1, #descendants do
        local anim = descendants[i]
        if anim:IsA("Animation") then
            local name = anim.Name:lower()
            local combo = tonumber(name:match("^(%d)"))
            local isM1 = combo and name:find("m1", 1, true) ~= nil
            local isM2 = name:sub(1, 2) == "m2"
            if isM1 or isM2 then
                local style = "default"
                local parent = anim.Parent
                if parent and parent.Name ~= "BaseCombat" then
                    style = parent.Name:lower():gsub("otheranims$", ""):gsub("anims$", "")
                end
                local delay
                pcall(function()
                    delay = isM1 and Combat.Config.GetScaledStyleM1HitboxDelay(style, combo, 1) or Combat.Config.GetStyleM2HitboxDelay(style)
                end)
                local id = anim.AnimationId:match("%d+")
                if id and type(delay) == "number" then
                    delays[id] = delay
                    count = count + 1
                end
            end
        end
    end
    return count
end

function Veneno_Parry.canParry(char)
    return char and char.Parent
        and char:GetAttribute("Equip") == true
        and char:GetAttribute("Ragdoll") ~= true
        and char:GetAttribute("Downed") ~= true
        and char:GetAttribute("GuardBroken") ~= true
        and char:GetAttribute("Greenzone") ~= true
        and char:GetAttribute("RpCombatLocked") ~= true
end

function Veneno_Parry.stopFacing()
    RunService:UnbindFromRenderStep(Veneno_Parry.faceBind)
    local state = Veneno_Parry.faceState
    if state and state.humanoid and state.humanoid.Parent and state.autoRotate ~= nil then
        state.humanoid.AutoRotate = state.autoRotate
    end
    Veneno_Parry.faceState = nil
end

local function faceTowards(char, targetRoot)
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root or not targetRoot then return end
    local goal = Vector3.new(targetRoot.Position.X, root.Position.Y, targetRoot.Position.Z)
    if (goal - root.Position).Magnitude > 0.01 then
        root.CFrame = CFrame.lookAt(root.Position, goal)
    end
end

function Veneno_Parry.holdFacing(char, targetRoot, duration)
    if not (Veneno_Parry.enabled and Veneno_Parry.autoFace) then return end
    local hum = Util.getHumanoid(char)
    if not hum or not targetRoot then return end
    
    local state = Veneno_Parry.faceState
    if not state or state.humanoid ~= hum then
        Veneno_Parry.stopFacing()
        state = { humanoid = hum, autoRotate = hum.AutoRotate, until_ = 0 }
        Veneno_Parry.faceState = state
    end
    
    state.character = char
    state.target = targetRoot
    state.until_ = math.max(state.until_, os.clock() + duration)
    hum.AutoRotate = false
    
    RunService:UnbindFromRenderStep(Veneno_Parry.faceBind)
    RunService:BindToRenderStep(Veneno_Parry.faceBind, Enum.RenderPriority.Camera.Value + 2, function()
        local current = Veneno_Parry.faceState
        if not current or not Veneno_Parry.enabled or not Veneno_Parry.autoFace
            or os.clock() >= current.until_
            or current.character ~= LocalPlayer.Character
            or not current.target or not current.target.Parent then
            Veneno_Parry.stopFacing()
            return
        end
        faceTowards(current.character, current.target)
    end)
end

function Veneno_Parry.parry()
    local char = LocalPlayer.Character
    if not Veneno_Parry.enabled or not Veneno_Parry.canParry(char) then return end
    
    Veneno_Parry.pulse = Veneno_Parry.pulse + 1
    local thisPulse = Veneno_Parry.pulse
    
    task.spawn(function()
        if not Veneno_Parry.enabled or char ~= LocalPlayer.Character or not Veneno_Parry.canParry(char) then return end
        if Combat.isBlocking(char) then
            Combat.unblock()
            task.wait()
        end
        Combat.block()
        task.delay(CONFIG.AutoParry.Hold, function()
            if Veneno_Parry.enabled and thisPulse == Veneno_Parry.pulse
                and char == LocalPlayer.Character and Combat.isBlocking(char) then
                Combat.unblock()
            end
        end)
    end)
end

function Veneno_Parry.onEnemyAnimation(enemyChar, track)
    if not Veneno_Parry.enabled then return end
    local anim = track.Animation
    local id = anim and anim.AnimationId:match("%d+")
    local delay = id and Veneno_Parry.attackDelays[id]
    if not delay then return end
    
    local myChar = LocalPlayer.Character
    local myRoot = Util.getRoot(myChar)
    local enemyRoot = enemyChar:FindFirstChild("HumanoidRootPart")
    if not myRoot or not enemyRoot then return end
    if (myRoot.Position - enemyRoot.Position).Magnitude > CONFIG.AutoParry.Range then return end
    if myChar:GetAttribute("Equip") ~= true then return end
    
    local speed = math.max(math.abs(track.Speed), 0.05)
    local parryDelay = math.max(0, delay / speed - Veneno_Parry.lead())
    
    Veneno_Parry.holdFacing(myChar, enemyRoot, parryDelay + CONFIG.AutoParry.Hold + CONFIG.AutoParry.FaceExtra)
    
    task.delay(parryDelay, function()
        if not Veneno_Parry.enabled then return end
        local char = LocalPlayer.Character
        local root = Util.getRoot(char)
        local target = enemyChar:FindFirstChild("HumanoidRootPart")
        if root and target and (root.Position - target.Position).Magnitude <= CONFIG.AutoParry.Range then
            Veneno_Parry.holdFacing(char, target, CONFIG.AutoParry.Hold + CONFIG.AutoParry.FaceExtra)
            Veneno_Parry.parry()
        end
    end)
end

function Veneno_Parry.wireCharacter(player, char)
    if player == LocalPlayer then return end
    local hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 5)
    local animator = hum and (hum:FindFirstChildOfClass("Animator") or hum:WaitForChild("Animator", 3))
    if not animator then return end
    Util.track(animator.AnimationPlayed:Connect(function(track)
        Veneno_Parry.onEnemyAnimation(char, track)
    end))
end

function Veneno_Parry.wirePlayer(player)
    if player.Character then
        task.spawn(Veneno_Parry.wireCharacter, player, player.Character)
    end
    Util.track(player.CharacterAdded:Connect(function(char)
        Veneno_Parry.wireCharacter(player, char)
    end))
end

function Veneno_Parry.init()
    Veneno_Parry.startPingSampler()
    Veneno_Parry.buildAttackTable()
    local players = Players:GetPlayers()
    for i = 1, #players do
        Veneno_Parry.wirePlayer(players[i])
    end
    Util.track(Players.PlayerAdded:Connect(Veneno_Parry.wirePlayer))
end

function Veneno_Parry.setEnabled(state)
    Veneno_Parry.enabled = state
    Veneno_Parry.pulse = Veneno_Parry.pulse + 1
    if not state then
        Veneno_Parry.stopFacing()
        local char = LocalPlayer.Character
        if Combat.isBlocking(char) then
            Combat.unblock()
        end
    end
end

local Veneno_Noclip = { 
    enabled = false, 
    connection = nil, 
    cachedParts = {},
    frameCounter = 0,
}

function Veneno_Noclip.set(state)
    Veneno_Noclip.enabled = state
    if Veneno_Noclip.connection then
        Veneno_Noclip.connection:Disconnect()
        Veneno_Noclip.connection = nil
    end
    if not state then
        local char = LocalPlayer.Character
        if char then
            local parts = Veneno_Noclip.cachedParts[char] or {}
            for i = 1, #parts do
                local p = parts[i]
                if p and p.Parent then p.CanCollide = true end
            end
            Veneno_Noclip.cachedParts[char] = nil
        end
        return
    end
    Veneno_Noclip.connection = heartbeat:Connect(function()
        Veneno_Noclip.frameCounter = Veneno_Noclip.frameCounter + 1
        if Veneno_Noclip.frameCounter % 3 ~= 0 then return end
        
        local char = LocalPlayer.Character
        if not char then return end
        local parts = Veneno_Noclip.cachedParts[char]
        if not parts then
            parts = {}
            local descendants = char:GetDescendants()
            for i = 1, #descendants do
                local p = descendants[i]
                if p:IsA("BasePart") then
                    table.insert(parts, p)
                end
            end
            Veneno_Noclip.cachedParts[char] = parts
        end
        for i = 1, #parts do
            local p = parts[i]
            if p and p.Parent then
                p.CanCollide = false
            end
        end
    end)
end

local Veneno_Fly = {
    active = false,
    speed = CONFIG.Fly.Speed,
    gyro = nil,
    velocity = nil,
    ownedNoclip = false,
    control = { F = 0, B = 0, L = 0, R = 0, Q = 0, E = 0 },
    lastControl = { F = 0, B = 0, L = 0, R = 0, Q = 0, E = 0 },
    connection = nil,
}

local function controlMagnitude(control)
    return math.abs(control.L + control.R) + math.abs(control.F + control.B) + math.abs(control.Q + control.E)
end

function Veneno_Fly.cleanup()
    if Veneno_Fly.gyro then
        pcall(function()
            Veneno_Fly.gyro:Destroy()
        end)
        Veneno_Fly.gyro = nil
    end
    
    if Veneno_Fly.velocity then
        pcall(function()
            Veneno_Fly.velocity:Destroy()
        end)
        Veneno_Fly.velocity = nil
    end
    
    if Veneno_Fly.connection then
        pcall(function()
            Veneno_Fly.connection:Disconnect()
        end)
        Veneno_Fly.connection = nil
    end
    
    local c = Veneno_Fly.control
    c.F, c.B, c.L, c.R, c.Q, c.E = 0, 0, 0, 0, 0, 0
    local l = Veneno_Fly.lastControl
    l.F, l.B, l.L, l.R, l.Q, l.E = 0, 0, 0, 0, 0, 0
end

function Veneno_Fly.start()
    if Veneno_Fly.active then return end
    
    local char = LocalPlayer.Character
    if not char then return end
    
    local hum = char:FindFirstChild("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not hum or not root then return end
    
    Veneno_Fly.active = true
    
    if not Veneno_Noclip.enabled then
        Veneno_Fly.ownedNoclip = true
        Veneno_Noclip.set(true)
    else
        Veneno_Fly.ownedNoclip = false
    end
    
    Veneno_Fly.cleanup()
    
    Veneno_Fly.gyro = Instance.new("BodyGyro")
    Veneno_Fly.gyro.P = 9e4
    Veneno_Fly.gyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
    Veneno_Fly.gyro.CFrame = root.CFrame
    Veneno_Fly.gyro.Parent = root
    
    Veneno_Fly.velocity = Instance.new("BodyVelocity")
    Veneno_Fly.velocity.Velocity = Vector3.zero
    Veneno_Fly.velocity.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    Veneno_Fly.velocity.Parent = root
    
    Veneno_Fly.connection = heartbeat:Connect(function()
        if not Veneno_Fly.active then return end
        
        local currentChar = LocalPlayer.Character
        if not currentChar then
            Veneno_Fly.stop()
            return
        end
        
        if currentChar ~= char then
            Veneno_Fly.stop()
            return
        end
        
        if currentChar:GetAttribute("Ragdoll") == true then
            return
        end
        
        if not Veneno_Fly.velocity or not Veneno_Fly.gyro then
            Veneno_Fly.stop()
            return
        end
        
        local camera = Workspace.CurrentCamera
        if not camera then return end
        
        local control = Veneno_Fly.control
        local moving = controlMagnitude(control) ~= 0
        local speed = moving and CONFIG.Fly.BaseSpeed or 0
        local source = moving and control or Veneno_Fly.lastControl
        
        if moving then
            local last = Veneno_Fly.lastControl
            last.F, last.B, last.L, last.R, last.Q, last.E = control.F, control.B, control.L, control.R, control.Q, control.E
        end
        
        if speed > 0 then
            local fwd = camera.CFrame.LookVector * (source.F + source.B)
            local lat = (camera.CFrame * CFrame.new(
                source.L + source.R,
                (source.F + source.B + control.Q + control.E) * 0.2,
                0
            ).Position) - camera.CFrame.Position
            Veneno_Fly.velocity.Velocity = (fwd + lat) * speed
        else
            Veneno_Fly.velocity.Velocity = Vector3.zero
        end
        
        Veneno_Fly.gyro.CFrame = camera.CFrame
        
        if hum and hum:GetState() ~= Enum.HumanoidStateType.Physics then
            hum.PlatformStand = false
        end
    end)
end

function Veneno_Fly.stop()
    if not Veneno_Fly.active then return end
    
    Veneno_Fly.active = false
    
    Veneno_Fly.cleanup()
    
    if Veneno_Fly.ownedNoclip then
        Veneno_Noclip.set(false)
        Veneno_Fly.ownedNoclip = false
    end
    
    local cam = Workspace.CurrentCamera
    if cam then
        pcall(function()
            cam.CameraType = Enum.CameraType.Custom
        end)
    end
end

function Veneno_Fly.set(state)
    if state then 
        Veneno_Fly.start() 
    else 
        Veneno_Fly.stop() 
    end
end

function Veneno_Fly.initInput()
    Util.track(UserInputService.InputBegan:Connect(function(input, processed)
        if processed or not Veneno_Fly.active then return end
        local key = input.KeyCode
        local speed = Veneno_Fly.speed
        local c = Veneno_Fly.control
        if key == Enum.KeyCode.W then c.F = speed
        elseif key == Enum.KeyCode.S then c.B = -speed
        elseif key == Enum.KeyCode.A then c.L = -speed
        elseif key == Enum.KeyCode.D then c.R = speed
        elseif key == Enum.KeyCode.E then c.Q = speed * CONFIG.Fly.VerticalBoost
        elseif key == Enum.KeyCode.Q then c.E = -speed * CONFIG.Fly.VerticalBoost
        end
    end))
    
    Util.track(UserInputService.InputEnded:Connect(function(input)
        if not Veneno_Fly.active then return end
        local key = input.KeyCode
        local c = Veneno_Fly.control
        if key == Enum.KeyCode.W then c.F = 0
        elseif key == Enum.KeyCode.S then c.B = 0
        elseif key == Enum.KeyCode.A then c.L = 0
        elseif key == Enum.KeyCode.D then c.R = 0
        elseif key == Enum.KeyCode.E then c.Q = 0
        elseif key == Enum.KeyCode.Q then c.E = 0
        end
    end))
end

local Veneno_Fling = {
    active = false,
    power = CONFIG.Fling.Power,
    targetMode = false,
    target = nil,
    connection = nil,
    partsByChar = {},
    charConnections = {},
    savedCollision = {},
    onStateChanged = nil,
    frameCounter = 0,
}

function Veneno_Fling.wireCharacter(char)
    if Veneno_Fling.partsByChar[char] then return end
    local parts = {}
    local descendants = char:GetDescendants()
    for i = 1, #descendants do
        local p = descendants[i]
        if p:IsA("BasePart") then
            table.insert(parts, p)
        end
    end
    Veneno_Fling.partsByChar[char] = parts
    
    table.insert(Veneno_Fling.charConnections, char.DescendantAdded:Connect(function(desc)
        if desc:IsA("BasePart") and Veneno_Fling.partsByChar[char] then
            table.insert(Veneno_Fling.partsByChar[char], desc)
        end
    end))
    
    table.insert(Veneno_Fling.charConnections, char.DescendantRemoving:Connect(function(desc)
        local list = Veneno_Fling.partsByChar[char]
        if list and desc:IsA("BasePart") then
            for j = #list, 1, -1 do
                if list[j] == desc then
                    table.remove(list, j)
                end
            end
        end
    end))
end

function Veneno_Fling.clearWiring()
    for i = 1, #Veneno_Fling.charConnections do
        pcall(Veneno_Fling.charConnections[i].Disconnect, Veneno_Fling.charConnections[i])
    end
    for k in pairs(Veneno_Fling.charConnections) do Veneno_Fling.charConnections[k] = nil end
    for k in pairs(Veneno_Fling.partsByChar) do Veneno_Fling.partsByChar[k] = nil end
end

function Veneno_Fling.ghost(part)
    if Veneno_Fling.savedCollision[part] == nil then
        Veneno_Fling.savedCollision[part] = part.CanCollide
    end
    part.CanCollide = false
end

function Veneno_Fling.restoreGhosts()
    for part, state in pairs(Veneno_Fling.savedCollision) do
        if part and part.Parent then
            part.CanCollide = state
        end
    end
    for k in pairs(Veneno_Fling.savedCollision) do Veneno_Fling.savedCollision[k] = nil end
end

function Veneno_Fling.victims()
    local victims = {}
    if Veneno_Fling.targetMode and Veneno_Fling.target and Veneno_Fling.target.Character then
        table.insert(victims, Veneno_Fling.target.Character)
    else
        local players = Players:GetPlayers()
        for i = 1, #players do
            local p = players[i]
            if p ~= LocalPlayer and p.Character then
                table.insert(victims, p.Character)
            end
        end
    end
    return victims
end

function Veneno_Fling.shouldFling(root)
    local victims = Veneno_Fling.victims()
    local pos = root.Position
    for i = 1, #victims do
        local targetRoot = victims[i]:FindFirstChild("HumanoidRootPart")
        if targetRoot and (pos - targetRoot.Position).Magnitude <= CONFIG.Fling.Radius then
            return true
        end
    end
    return false
end

function Veneno_Fling.pulse(root)
    local char = LocalPlayer.Character
    if not char then return end
    
    local ghosted = {}
    local descendants = char:GetDescendants()
    for i = 1, #descendants do
        local p = descendants[i]
        if p:IsA("BasePart") and p.CanCollide then
            Veneno_Fling.ghost(p)
            table.insert(ghosted, p)
        end
    end
    
    local strength = Veneno_Fling.power * 500
    local prev = root.AssemblyLinearVelocity
    Util.setVelocity(root, Vector3.new(strength, strength, strength))
    pcall(renderStepped.Wait, renderStepped)
    Util.setVelocity(root, prev)
    
    for i = 1, #ghosted do
        local p = ghosted[i]
        if p and p.Parent then
            p.CanCollide = true
        end
        Veneno_Fling.savedCollision[p] = nil
    end
end

function Veneno_Fling.step()
    if not Veneno_Fling.active then return end
    local root = Util.getRoot()
    if not root then return end
    
    local victims = Veneno_Fling.victims()
    for i = 1, #victims do
        local char = victims[i]
        Veneno_Fling.wireCharacter(char)
        local parts = Veneno_Fling.partsByChar[char]
        if parts then
            for j = 1, #parts do
                local p = parts[j]
                if p and p.Parent and p.CanCollide then
                    Veneno_Fling.ghost(p)
                end
            end
        end
    end
    
    if Veneno_Fling.shouldFling(root) then
        Veneno_Fling.pulse(root)
    end
end

function Veneno_Fling.set(state)
    Veneno_Fling.active = state
    if Veneno_Fling.connection then
        Veneno_Fling.connection:Disconnect()
        Veneno_Fling.connection = nil
    end
    if not state then
        Veneno_Fling.clearWiring()
        Veneno_Fling.restoreGhosts()
        local char = LocalPlayer.Character
        if char then
            local descendants = char:GetDescendants()
            for i = 1, #descendants do
                local p = descendants[i]
                if p:IsA("BasePart") then
                    Util.setVelocity(p, Vector3.zero)
                end
            end
        end
        if Veneno_Fling.onStateChanged then Veneno_Fling.onStateChanged(false) end
        return
    end
    Veneno_Fling.connection = heartbeat:Connect(function()
        Veneno_Fling.frameCounter = Veneno_Fling.frameCounter + 1
        Veneno_Fling.step()
    end)
    if Veneno_Fling.onStateChanged then Veneno_Fling.onStateChanged(true) end
end

function Veneno_Fling.initDeathHandling()
    local function wire(char)
        local hum = char:WaitForChild("Humanoid", 5)
        if hum then
            Util.track(hum.Died:Connect(function()
                if Veneno_Fling.active then Veneno_Fling.set(false) end
            end))
        end
    end
    local char = LocalPlayer.Character
    if char then task.spawn(wire, char) end
    Util.track(LocalPlayer.CharacterAdded:Connect(function(char)
        task.spawn(wire, char)
        if Veneno_Fling.active then Veneno_Fling.clearWiring() end
    end))
end

local Veneno_AntiFling = {
    enabled = false,
    connection = nil,
    partsByChar = {},
    charConnections = {},
    savedCollision = {},
    frameCounter = 0,
}

function Veneno_AntiFling.wireCharacter(char)
    if Veneno_AntiFling.partsByChar[char] then return end
    local parts = {}
    local descendants = char:GetDescendants()
    for i = 1, #descendants do
        local p = descendants[i]
        if p:IsA("BasePart") then
            if Veneno_AntiFling.savedCollision[p] == nil then
                Veneno_AntiFling.savedCollision[p] = p.CanCollide
            end
            table.insert(parts, p)
        end
    end
    Veneno_AntiFling.partsByChar[char] = parts
    table.insert(Veneno_AntiFling.charConnections, char.DescendantAdded:Connect(function(desc)
        if desc:IsA("BasePart") then
            if Veneno_AntiFling.savedCollision[desc] == nil then
                Veneno_AntiFling.savedCollision[desc] = desc.CanCollide
            end
            local list = Veneno_AntiFling.partsByChar[char]
            if list then table.insert(list, desc) end
        end
    end))
end

function Veneno_AntiFling.wirePlayer(player)
    if player == LocalPlayer then return end
    if player.Character then Veneno_AntiFling.wireCharacter(player.Character) end
    table.insert(Veneno_AntiFling.charConnections, player.CharacterAdded:Connect(Veneno_AntiFling.wireCharacter))
end

function Veneno_AntiFling.set(state)
    Veneno_AntiFling.enabled = state
    if Veneno_AntiFling.connection then
        Veneno_AntiFling.connection:Disconnect()
        Veneno_AntiFling.connection = nil
    end
    if not state then
        for part, value in pairs(Veneno_AntiFling.savedCollision) do
            if part and part.Parent then
                part.CanCollide = value
            end
        end
        for k in pairs(Veneno_AntiFling.savedCollision) do Veneno_AntiFling.savedCollision[k] = nil end
        for i = 1, #Veneno_AntiFling.charConnections do
            pcall(Veneno_AntiFling.charConnections[i].Disconnect, Veneno_AntiFling.charConnections[i])
        end
        for k in pairs(Veneno_AntiFling.charConnections) do Veneno_AntiFling.charConnections[k] = nil end
        for k in pairs(Veneno_AntiFling.partsByChar) do Veneno_AntiFling.partsByChar[k] = nil end
        return
    end
    local players = Players:GetPlayers()
    for i = 1, #players do Veneno_AntiFling.wirePlayer(players[i]) end
    table.insert(Veneno_AntiFling.charConnections, Players.PlayerAdded:Connect(Veneno_AntiFling.wirePlayer))
    Veneno_AntiFling.connection = heartbeat:Connect(function()
        Veneno_AntiFling.frameCounter = Veneno_AntiFling.frameCounter + 1
        if Veneno_AntiFling.frameCounter % 3 ~= 0 then return end
        
        for _, parts in pairs(Veneno_AntiFling.partsByChar) do
            for i = 1, #parts do
                local p = parts[i]
                if p and p.Parent and p.CanCollide then
                    p.CanCollide = false
                end
            end
        end
    end)
end

