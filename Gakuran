local Veneno_ShadowStep = {
    enabled = false,
    distance = CONFIG.ShadowStep.Distance,
    cooldown = false,
}

function Veneno_ShadowStep.dash()
    if not Veneno_ShadowStep.enabled or Veneno_ShadowStep.cooldown then return end
    local root = Util.getRoot()
    local camera = Workspace.CurrentCamera
    if not root or not camera then return end
    local look = camera.CFrame.LookVector
    local dir = Vector3.new(look.X, 0, look.Z)
    if dir.Magnitude > 0 then dir = dir.Unit end
    root.CFrame = root.CFrame + dir * Veneno_ShadowStep.distance
    task.spawn(function()
        local char = LocalPlayer.Character
        if not char then return end
        local descendants = char:GetDescendants()
        for i = 1, #descendants do
            local p = descendants[i]
            if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
                local orig = p.Material
                p.Material = Enum.Material.Neon
                task.delay(0.12, function()
                    if p and p.Parent then p.Material = orig end
                end)
            end
        end
    end)
    Veneno_ShadowStep.cooldown = true
    task.delay(CONFIG.ShadowStep.Cooldown, function()
        Veneno_ShadowStep.cooldown = false
    end)
end

local Veneno_ESP = {
    namesVisible = false,
    barsVisible = false,
}

local ESP_TAG = "VenenoHubTag"

local function buildTag(player, char)
    local head = char:FindFirstChild("Head") or char:WaitForChild("Head", 5)
    if not head then return end
    local old = head:FindFirstChild(ESP_TAG)
    if old then old:Destroy() end
    
    local gui = Instance.new("BillboardGui")
    gui.Name = ESP_TAG
    gui.Adornee = head
    gui.Size = UDim2.fromOffset(180, 40)
    gui.StudsOffset = Vector3.new(0, 2.8, 0)
    gui.MaxDistance = 500
    gui.AlwaysOnTop = true
    gui.Enabled = Veneno_ESP.namesVisible or Veneno_ESP.barsVisible
    gui.Parent = head
    
    local name = Instance.new("TextLabel")
    name.Name = "Name"
    name.Size = UDim2.new(1, 0, 0, 18)
    name.Position = UDim2.new(0, 0, 0, 0)
    name.BackgroundTransparency = 1
    name.Text = player.Name
    name.TextColor3 = Color3.new(1, 1, 1)
    name.TextStrokeTransparency = 0
    name.TextStrokeColor3 = Color3.new(0, 0, 0)
    name.Font = Enum.Font.GothamBold
    name.TextSize = 12
    name.Visible = Veneno_ESP.namesVisible
    name.Parent = gui
    
    local healthText = Instance.new("TextLabel")
    healthText.Name = "HealthText"
    healthText.Size = UDim2.new(1, 0, 0, 16)
    healthText.Position = UDim2.new(0, 0, 0, 20)
    healthText.BackgroundTransparency = 1
    healthText.Text = "100%"
    healthText.TextColor3 = Color3.fromRGB(90, 220, 120)
    healthText.TextStrokeTransparency = 0
    healthText.TextStrokeColor3 = Color3.new(0, 0, 0)
    healthText.Font = Enum.Font.GothamMedium
    healthText.TextSize = 11
    healthText.Visible = Veneno_ESP.barsVisible
    healthText.Parent = gui
    
    local hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 5)
    if hum then
        local function update()
            local healthPercent = hum.MaxHealth > 0 and math.clamp(hum.Health / hum.MaxHealth * 100, 0, 100) or 0
            healthText.Text = math.floor(healthPercent + 0.5) .. "%"
            if healthPercent > 60 then
                healthText.TextColor3 = Color3.fromRGB(90, 220, 120)
            elseif healthPercent > 30 then
                healthText.TextColor3 = Color3.fromRGB(255, 200, 50)
            else
                healthText.TextColor3 = Color3.fromRGB(255, 50, 50)
            end
        end
        update()
        Util.track(hum.HealthChanged:Connect(update))
    end
end

function Veneno_ESP.wirePlayer(player)
    if player == LocalPlayer then return end
    if player.Character then task.spawn(buildTag, player, player.Character) end
    Util.track(player.CharacterAdded:Connect(function(char)
        task.spawn(buildTag, player, char)
    end))
end

function Veneno_ESP.refresh()
    local players = Players:GetPlayers()
    for i = 1, #players do
        local char = players[i].Character
        local head = char and char:FindFirstChild("Head")
        local gui = head and head:FindFirstChild(ESP_TAG)
        if gui then
            gui.Enabled = Veneno_ESP.namesVisible or Veneno_ESP.barsVisible
            local name = gui:FindFirstChild("Name")
            local healthText = gui:FindFirstChild("HealthText")
            if name then name.Visible = Veneno_ESP.namesVisible end
            if healthText then healthText.Visible = Veneno_ESP.barsVisible end
        end
    end
end

function Veneno_ESP.init()
    local players = Players:GetPlayers()
    for i = 1, #players do Veneno_ESP.wirePlayer(players[i]) end
    Util.track(Players.PlayerAdded:Connect(Veneno_ESP.wirePlayer))
end

local Veneno_Spectate = { target = nil, connection = nil }

function Veneno_Spectate.stop()
    if Veneno_Spectate.connection then
        Veneno_Spectate.connection:Disconnect()
        Veneno_Spectate.connection = nil
    end
    Veneno_Spectate.target = nil
    local camera = Workspace.CurrentCamera
    if camera then camera.CameraSubject = Util.getHumanoid() end
end

function Veneno_Spectate.start(name)
    local player = Util.findPlayer(name)
    if not player then return false, "Player not found" end
    Veneno_Spectate.stop()
    Veneno_Spectate.target = player
    local function attach(char)
        local hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 5)
        local camera = Workspace.CurrentCamera
        if hum and camera then camera.CameraSubject = hum end
    end
    if player.Character then attach(player.Character) end
    Veneno_Spectate.connection = player.CharacterAdded:Connect(attach)
    return true, "Spectating " .. player.Name
end

local function teleportToPlayer(name)
    local player = Util.findPlayer(name)
    if not player then return false, "Player not found" end
    local targetRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    local root = Util.getRoot()
    if not targetRoot or not root then return false, "Character unavailable" end
    root.CFrame = targetRoot.CFrame * CFrame.new(0, 0, 3)
    return true, "Teleported to " .. player.Name
end

local rejoinCooldown = false
local function rejoinServer()
    if rejoinCooldown then return false, "Wait a few seconds" end
    rejoinCooldown = true
    Veneno_Fling.set(false)
    pcall(function()
        TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
    end)
    task.delay(10, function() rejoinCooldown = false end)
    return true, "Reconnecting..."
end

local function forceReset()
    local root = Util.getRoot()
    if not root then return false, "Character unavailable" end
    Util.setVelocity(root, Vector3.new(0, 200000, 0))
    return true, "Launched!"
end

