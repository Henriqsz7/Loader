local function loadLibrary()
    local sources = {
        "https://raw.githubusercontent.com/x8lua/scripts/main/imgui-roblox/ImGui.lua?nocache=" .. tostring(tick()),
    }
    for i = 1, #sources do
        local ok, body = pcall(game.HttpGet, game, sources[i])
        if ok and type(body) == "string" and #body > 0 then
            local loaded, chunk = pcall(loadstring, body)
            if loaded and type(chunk) == "function" then
                local built, library = pcall(chunk)
                if built and library then
                    return library
                end
            end
        end
    end
    return nil
end

