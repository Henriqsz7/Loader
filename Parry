local function getEnemyStyle(character, fallback)
    local style = nil
    if character then
        pcall(function()
            style = CombatAnimationUtils.GetCombatStyleForCharacter(character)
        end)
        if not style then
            local pd = character:FindFirstChild("PlayerData")
            if pd then style = pd:GetAttribute("CombatStyle") end
        end
        if not style then
            style = character:GetAttribute("CombatStyle")
        end
    end
    style = style or fallback or "default"
    return tostring(style):lower():gsub("%s+", "")
end

local function resolveStyleKey(rawStyle)
    local s = tostring(rawStyle or ""):lower():gsub("%s+", "")
    if s:find("box", 1, true) then return "boxing" end
    if s:find("wrestl", 1, true) then return "wrestling" end
    if s:find("judo", 1, true) then return "judo" end
    if s:find("mishima", 1, true) then return "mishima" end
    if s:find("jin", 1, true) then return "jin" end
    if s:find("dragon", 1, true) then return "dragon" end
    if s:find("kure", 1, true) then return "kure" end
    if s:find("capo", 1, true) then return "capoeira" end
    if s:find("ali", 1, true) then return "ali" end
    if s:find("kyoku", 1, true) then return "kyokushin" end
    if s:find("slug", 1, true) then return "slugger" end
    if s:find("hakari", 1, true) then return "hakari" end
    if s:find("wing", 1, true) then return "wingchun" end
    return "basic"
end

local function stopAutoFacing()
    pcall(function()
        RunService:UnbindFromRenderStep(State.faceBind)
    end)
    State.faceTarget = nil
    State.faceUntil = 0
end

local function faceTarget(targetRoot, duration)
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot or not targetRoot then return end

    State.faceTarget = targetRoot
    State.faceUntil = os.clock() + (duration or 0.4)

    local targetPos = Vector3.new(targetRoot.Position.X, myRoot.Position.Y, targetRoot.Position.Z)
    local diff = targetPos - myRoot.Position
    if (diff.X * diff.X + diff.Z * diff.Z) > 0.001 then
        myRoot.CFrame = CFrame.lookAt(myRoot.Position, targetPos)
    end

    pcall(function()
        RunService:BindToRenderStep(State.faceBind, Enum.RenderPriority.Camera.Value - 1, function()
            if State.unloading or not State.autoFace or os.clock() > State.faceUntil then
                stopAutoFacing()
                return
            end
            local c = LocalPlayer.Character
            local r = c and c:FindFirstChild("HumanoidRootPart")
            local t = State.faceTarget
            if not r or not t or not t.Parent then
                stopAutoFacing()
                return
            end
            local p = r.Position
            local tp = Vector3.new(t.Position.X, p.Y, t.Position.Z)
            local d = tp - p
            if (d.X * d.X + d.Z * d.Z) > 0.001 then
                r.CFrame = CFrame.lookAt(p, tp)
            end
        end)
    end)
end

local function getBestLateralDirection(myRoot, enemyRoot)
    local toEnemy = Vector3.new(enemyRoot.Position.X - myRoot.Position.X, 0, enemyRoot.Position.Z - myRoot.Position.Z)
    local enemyUnit = toEnemy.Magnitude > 0.1 and toEnemy.Unit or myRoot.CFrame.LookVector
    local right = Vector3.new(-enemyUnit.Z, 0, enemyUnit.X)
    local left = -right

    local origin = myRoot.Position
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = { LocalPlayer.Character, enemyRoot.Parent }

    local hitRight = workspace:Raycast(origin, right * 15, rayParams)
    local hitLeft = workspace:Raycast(origin, left * 15, rayParams)

    local distRight = hitRight and (hitRight.Position - origin).Magnitude or 15
    local distLeft = hitLeft and (hitLeft.Position - origin).Magnitude or 15

    local chosenLateral
    if distRight >= 7 and distLeft < 7 then
        chosenLateral = right
    elseif distLeft >= 7 and distRight < 7 then
        chosenLateral = left
    elseif distRight > distLeft then
        chosenLateral = right
    elseif distLeft > distRight then
        chosenLateral = left
    else
        local enemyLook = enemyRoot.CFrame.LookVector
        if enemyLook:Dot(right) > 0 then
            chosenLateral = left
        else
            chosenLateral = right
        end
    end

    return chosenLateral.Unit
end

local function isFacingTarget(myRoot, targetRoot, minDot)
    local toTarget = Vector3.new(targetRoot.Position.X - myRoot.Position.X, 0, targetRoot.Position.Z - myRoot.Position.Z)
    local myLook = Vector3.new(myRoot.CFrame.LookVector.X, 0, myRoot.CFrame.LookVector.Z)
    if toTarget.Magnitude > 0.1 and myLook.Magnitude > 0.1 then
        return toTarget.Unit:Dot(myLook.Unit) >= (minDot or 0.25)
    end
    return true
end

local function performSmartDodge(styleKey, enemyRoot)
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local myRoot = character and character:FindFirstChild("HumanoidRootPart")
    if not character or not humanoid or not myRoot or not enemyRoot or not canAct(character) or character:GetAttribute("Equip") ~= true or (not State.autoDash and not State.npcDash) then return end

    if character:GetAttribute("Blocking") == true then
        pcall(Block.Unblock)
    end

    if State.noCooldown then
        character:SetAttribute("IFRAMECD", nil)
        character:SetAttribute("EvasiveCooldownRemaining", nil)
    end

    local toEnemy = Vector3.new(enemyRoot.Position.X - myRoot.Position.X, 0, enemyRoot.Position.Z - myRoot.Position.Z)
    if toEnemy.Magnitude < 0.1 then return end

    myRoot.CFrame = CFrame.lookAt(myRoot.Position, Vector3.new(enemyRoot.Position.X, myRoot.Position.Y, enemyRoot.Position.Z))

    local dirOption = (styleKey and State.styleDirections[styleKey]) or "Backward"
    local moveDir
    if dirOption == "Right" then
        moveDir = myRoot.CFrame.RightVector
    elseif dirOption == "Left" then
        moveDir = -myRoot.CFrame.RightVector
    else
        moveDir = -toEnemy.Unit
    end

    local prevAutoRotate = humanoid.AutoRotate
    humanoid.AutoRotate = false
    humanoid:Move(moveDir, false)

    pcall(Evasive.Evasive)

    local speed = State.dashSpeed or 33
    local vel = myRoot:FindFirstChild("DashVelocity")
    if vel and vel:IsA("LinearVelocity") then
        vel.VectorVelocity = moveDir * speed
    else
        local att = myRoot:FindFirstChild("DashAttachment") or Instance.new("Attachment", myRoot)
        att.Name = "DashAttachment"
        local lv = Instance.new("LinearVelocity")
        lv.Name = "DashVelocity"
        lv.MaxForce = 35000
        lv.VectorVelocity = moveDir * speed
        lv.Attachment0 = att
        lv.RelativeTo = Enum.ActuatorRelativeTo.World
        lv.Parent = myRoot
        Debris:AddItem(att, 0.22)
        Debris:AddItem(lv, 0.22)
    end

    task.delay(0.22, function()
        local c = LocalPlayer.Character
        local h = c and c:FindFirstChildOfClass("Humanoid")
        if h then
            h:Move(Vector3.zero, false)
            h.AutoRotate = prevAutoRotate
        end
    end)
end

local function triggerDodge(styleKey, enemyRoot, delaySeconds)
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot or not enemyRoot or not enemyRoot.Parent or not canAct(myChar) or myChar:GetAttribute("Equip") ~= true or (not State.autoDash and not State.npcDash) then return end

    local initialDist = (Vector3.new(myRoot.Position.X, 0, myRoot.Position.Z) - Vector3.new(enemyRoot.Position.X, 0, enemyRoot.Position.Z)).Magnitude
    if initialDist > State.parryDistance then return end

    if delaySeconds and delaySeconds > 0.03 then
        task.delay(delaySeconds, function()
            if State.unloading or (not State.autoDash and not State.npcDash) then return end
            myChar = LocalPlayer.Character
            myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
            if myRoot and enemyRoot and enemyRoot.Parent and canAct(myChar) and myChar:GetAttribute("Equip") == true then
                local currentDist = (Vector3.new(myRoot.Position.X, 0, myRoot.Position.Z) - Vector3.new(enemyRoot.Position.X, 0, enemyRoot.Position.Z)).Magnitude
                if currentDist <= State.parryDistance then
                    performSmartDodge(styleKey, enemyRoot)
                end
            end
        end)
    else
        performSmartDodge(styleKey, enemyRoot)
    end
end

local function handleBoxingHold(enemyChar, track)
    local myChar = LocalPlayer.Character
    if not myChar or not canAct(myChar) or myChar:GetAttribute("Equip") ~= true then return end

    if myChar:GetAttribute("Blocking") ~= true then
        pcall(Block.Block)
    end

    local timeout = os.clock() + 1.2
    local conn
    conn = RunService.Heartbeat:Connect(function()
        local isStillPlaying = track and track.IsPlaying
        local active = State.boxingHold
        if State.unloading or not isStillPlaying or os.clock() > timeout or not active then
            if conn then
                conn:Disconnect()
            end
            local c = LocalPlayer.Character
            if c and c:GetAttribute("Blocking") == true then
                pcall(Block.Unblock)
            end
        end
    end)
    trackConn(conn)
end

local function applyParryPulse(holdTime)
    local character = LocalPlayer.Character
    if (not State.autoParry and not State.npcParry) or not canAct(character) then return end

    if State.autoEquip and character:GetAttribute("Equip") ~= true then
        ensureEquipped()
    end

    character:SetAttribute("BlockCooldown", nil)
    character:SetAttribute("ParryWindowDisabled", nil)
    character:SetAttribute("ParryBuffered", true)

    local setupVal = debug and debug.setupvalue or setupvalue
    if typeof(setupVal) == "function" then
        pcall(setupVal, Block.Block, 6, 0)
    end

    State.pulse = State.pulse + 1
    local thisPulse = State.pulse

    if character:GetAttribute("Blocking") == true then
        pcall(Block.Unblock)
    end
    pcall(Block.Block)

    task.delay(holdTime or 0.22, function()
        if State.unloading then return end
        if thisPulse == State.pulse and character == LocalPlayer.Character then
            if character:GetAttribute("Blocking") == true then
                pcall(Block.Unblock)
            end
            character:SetAttribute("ParryBuffered", nil)
        end
    end)
end

local function isAttackerFacingMe(enemyRoot, myRoot)
    local toMe = Vector3.new(myRoot.Position.X - enemyRoot.Position.X, 0, myRoot.Position.Z - enemyRoot.Position.Z)
    local dist = toMe.Magnitude
    if dist <= 14 then
        return true
    end

    local enemyLook = Vector3.new(enemyRoot.CFrame.LookVector.X, 0, enemyRoot.CFrame.LookVector.Z)
    if dist > 0.1 and enemyLook.Magnitude > 0.1 then
        local dot = toMe.Unit:Dot(enemyLook.Unit)
        if dot < -0.15 then
            return false
        end
    end

    return true
end

