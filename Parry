local function handleHeavyDetection(character, track)
    if not character or not track then return end
    local anim = track.Animation
    local id = anim and anim.AnimationId:match("%d+")
    local attackData = id and State.attackCatalog[id]
    local lowerName = anim and anim.Name:lower() or ""

    local isHeavy = (attackData and attackData.isM2)
        or lowerName:find("m2", 1, true) ~= nil
        or lowerName:find("armored", 1, true) ~= nil
        or lowerName:find("crit", 1, true) ~= nil
        or lowerName:find("slam", 1, true) ~= nil
        or lowerName:find("grab", 1, true) ~= nil
        or lowerName:find("heavy", 1, true) ~= nil
        or lowerName:find("guardbreak", 1, true) ~= nil
        or lowerName:find("momentum", 1, true) ~= nil
        or lowerName:find("uppercut", 1, true) ~= nil
        or lowerName == "r"
        or lowerName:match("^r_") ~= nil
        or lowerName:match("_r$") ~= nil

    if isHeavy then
        local style = (attackData and attackData.baseStyle ~= "default" and attackData.baseStyle) or getEnemyStyle(character, "basic")
        recordM2Cooldown(character, style)
    end
end

local function wireCharacter(player, character)
    if not character or character == LocalPlayer.Character or wiredEntities[character] then return end
    if player == LocalPlayer then return end
    wiredEntities[character] = true

    local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 5)
    if not humanoid then return end

    local function attachAnimator(animator)
        if not animator or not animator:IsA("Animator") then return end
        trackConn(animator.AnimationPlayed:Connect(function(track)
            handleHeavyDetection(character, track)
            onEnemyAnimation(player, character, track)
        end))
    end

    local existingAnim = humanoid:FindFirstChildOfClass("Animator")
    if existingAnim then
        attachAnimator(existingAnim)
    else
        trackConn(humanoid.ChildAdded:Connect(function(child)
            if child:IsA("Animator") then
                attachAnimator(child)
            end
        end))
        task.spawn(function()
            local a = humanoid:WaitForChild("Animator", 5)
            if a then attachAnimator(a) end
        end)
    end

    trackConn(character.AttributeChanged:Connect(function(name)
        local lower = name:lower()
        if lower:find("m2") or lower:find("heavy") then
            local val = character:GetAttribute(name)
            if val == true or (typeof(val) == "number" and val > 0) then
                local style = getEnemyStyle(character, "basic")
                recordM2Cooldown(character, style)
            end
        end
    end))
end

