local function canAct(character)
    return character
        and character.Parent
        and character:GetAttribute("Ragdoll") ~= true
        and character:GetAttribute("Downed") ~= true
        and character:GetAttribute("GuardBroken") ~= true
        and character:GetAttribute("Greenzone") ~= true
        and character:GetAttribute("RpCombatLocked") ~= true
end

local function catalogAnimations()
    local animFolder = ReplicatedStorage:FindFirstChild("Animations")
    if not animFolder then return end

    for _, anim in ipairs(animFolder:GetDescendants()) do
        if anim:IsA("Animation") then
            local id = anim.AnimationId:match("%d+")
            if id then
                local lowerName = anim.Name:lower()
                local parent = anim.Parent
                local baseStyle = "default"
                if parent and parent.Name ~= "BaseCombat" then
                    baseStyle = parent.Name:lower():gsub("otheranims$", ""):gsub("anims$", "")
                end

                local isDefensiveOrReaction = lowerName:find("parry", 1, true)
                    or lowerName:find("block", 1, true)
                    or lowerName:find("ehit", 1, true)
                    or lowerName:find("dodge", 1, true)
                    or lowerName:find("dash", 1, true)
                    or lowerName:find("idle", 1, true)
                    or lowerName:find("walk", 1, true)
                    or lowerName:find("run", 1, true)
                    or lowerName:find("stagger", 1, true)
                    or lowerName:find("react", 1, true)
                    or lowerName:find("victim", 1, true)

                if not isDefensiveOrReaction then
                    local combo = tonumber(lowerName:match("^(%d)"))
                    local isM1 = (combo ~= nil and lowerName:find("m1", 1, true) ~= nil)
                    local isMomentum = lowerName:find("momentum", 1, true) ~= nil
                    local isCrit = lowerName:find("crit", 1, true) ~= nil
                    local isGrapple = lowerName:find("attacker", 1, true) ~= nil and lowerName:find("victim", 1, true) == nil
                    local isHeavyName = lowerName:find("heavy", 1, true) ~= nil or lowerName:find("guardbreak", 1, true) ~= nil or lowerName == "r" or lowerName:match("^r_") ~= nil or lowerName:match("_r$") ~= nil
                    local isM2 = lowerName:find("m2", 1, true) ~= nil or isMomentum or isCrit or isGrapple or isHeavyName

                    if isM1 or isM2 then
                    local fallbackDelay = 0.32
                    if isM2 then
                        pcall(function()
                            if isMomentum and baseStyle == "hakari" then
                                fallbackDelay = CombatConfig.GetStyleM2HitboxDelay("hakari", true)
                            else
                                fallbackDelay = CombatConfig.GetStyleM2HitboxDelay(baseStyle)
                            end
                        end)
                        if not fallbackDelay or typeof(fallbackDelay) ~= "number" then
                            fallbackDelay = (baseStyle == "boxing" and 0.43) or 0.35
                        end
                    else
                        pcall(function()
                            fallbackDelay = CombatConfig.GetScaledStyleM1HitboxDelay(baseStyle, combo or 1, 1)
                        end)
                        if not fallbackDelay or typeof(fallbackDelay) ~= "number" then
                            fallbackDelay = 0.30
                        end
                    end

                    State.attackCatalog[id] = {
                        isM2 = isM2,
                        combo = combo or 1,
                        isMomentum = isMomentum,
                        baseStyle = baseStyle,
                        fallbackDelay = fallbackDelay,
                        name = anim.Name
                    }
                end
            end
        end
    end
end
end

