local function recordM2Cooldown(character, style)
    if not character then return end
    local cd = 7
    pcall(function()
        cd = CombatConfig.GetStyleM2Cooldown(style or "default")
    end)
    if not cd or typeof(cd) ~= "number" or cd <= 0 then
        cd = 7
    end
    local now = os.clock()
    local existing = State.m2Cooldowns[character]
    if existing and typeof(existing) == "table" and existing.endsAt and existing.endsAt > now + 0.5 then
        return
    end
    State.m2Cooldowns[character] = {
        startedAt = now,
        duration = cd,
        endsAt = now + cd,
    }
end

local function updateSingleCharacterInfo(char, isLocal)
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local head = char:FindFirstChild("Head")
    if hum and head and hum.Health > 0 then
        local gui = getOrCreatePlayerInfoGui(char)
        if gui then
            local hpLabel = gui:FindFirstChild("HPLabel")
            local rLabel = gui:FindFirstChild("RLabel")

            local healthRatio = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
            if hpLabel then
                hpLabel.Text = string.format("HP: %d / %d", math.ceil(hum.Health), math.ceil(hum.MaxHealth))
                if isLocal then
                    hpLabel.TextColor3 = Color3.fromRGB(80, 220, 255)
                else
                    hpLabel.TextColor3 = Color3.fromHSV(healthRatio * 0.33, 0.9, 1)
                end
            end

            local cdData = State.m2Cooldowns[char]
            local rem = 0
            if cdData and typeof(cdData) == "table" and cdData.endsAt then
                rem = math.max(0, cdData.endsAt - os.clock())
            elseif typeof(cdData) == "number" then
                rem = math.max(0, cdData - os.clock())
            end

            if rLabel then
                if rem > 0.05 then
                    rLabel.Text = string.format("R: %.1fs", rem)
                    if isLocal then
                        rLabel.TextColor3 = Color3.fromRGB(255, 185, 50)
                    else
                        rLabel.TextColor3 = Color3.fromRGB(255, 75, 75)
                    end
                else
                    rLabel.Text = "R: READY"
                    if isLocal then
                        rLabel.TextColor3 = Color3.fromRGB(50, 255, 210)
                    else
                        rLabel.TextColor3 = Color3.fromRGB(60, 255, 120)
                    end
                end
            end
            gui.Enabled = true
        end
    else
        local g = State.playerInfoGuis[char]
        if g then g.Enabled = false end
    end
end

local function updatePlayerInfo()
    if not State.showPlayerInfo or State.unloading then return end

    local myChar = LocalPlayer.Character
    if myChar then
        updateSingleCharacterInfo(myChar, true)
    end

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            updateSingleCharacterInfo(p.Character, false)
        end
    end
end

local function onEnemyAnimation(player, character, track)
    if State.unloading or not character or not track then return end

    local anim = track.Animation
    local id = anim and anim.AnimationId:match("%d+")
    local attackData = id and State.attackCatalog[id]
    local lowerName = anim and anim.Name:lower() or ""

    if lowerName:find("parry", 1, true)
        or lowerName:find("block", 1, true)
        or lowerName:find("ehit", 1, true)
        or lowerName:find("dodge", 1, true)
        or lowerName:find("dash", 1, true)
        or lowerName:find("idle", 1, true)
        or lowerName:find("walk", 1, true)
        or lowerName:find("run", 1, true)
        or lowerName:find("stagger", 1, true)
        or lowerName:find("stun", 1, true)
        or lowerName:find("hurt", 1, true)
        or lowerName:find("react", 1, true)
        or lowerName:find("victim", 1, true) then
        return
    end

    local isM2 = attackData and attackData.isM2 or false
    local isHeavy = isM2
        or lowerName:find("m2", 1, true) ~= nil
        or lowerName:find("armored", 1, true) ~= nil
        or lowerName:find("crit", 1, true) ~= nil
        or lowerName:find("slam", 1, true) ~= nil
        or lowerName:find("grab", 1, true) ~= nil
        or lowerName:find("heavy", 1, true) ~= nil
        or lowerName:find("guardbreak", 1, true) ~= nil
        or lowerName == "r"
        or lowerName:match("^r_") ~= nil
        or lowerName:match("_r$") ~= nil

    local isNpc = (player == nil)
    local canDash = (isNpc and State.npcDash) or (not isNpc and State.autoDash)
    local canParry = (isNpc and State.npcParry) or (not isNpc and State.autoParry)
    if not canDash and not canParry then return end

    local isLight = not isHeavy and (attackData ~= nil
        or lowerName:find("m1", 1, true) ~= nil
        or lowerName:match("^(%d)") ~= nil
        or lowerName:find("attack", 1, true) ~= nil
        or lowerName:find("punch", 1, true) ~= nil
        or lowerName:find("kick", 1, true) ~= nil
        or lowerName:find("strike", 1, true) ~= nil
        or lowerName:find("swing", 1, true) ~= nil
        or lowerName:find("combo", 1, true) ~= nil
        or lowerName:find("jab", 1, true) ~= nil
        or lowerName:find("hook", 1, true) ~= nil
        or lowerName:find("fist", 1, true) ~= nil
        or lowerName:find("rush", 1, true) ~= nil
        or lowerName:find("hit", 1, true) ~= nil
        or lowerName:find("slash", 1, true) ~= nil
        or isNpc)

    if not isHeavy and not isLight then return end

    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local enemyRoot = character:FindFirstChild("HumanoidRootPart")
    if not myRoot or not enemyRoot or not canAct(myChar) then return end

    local dist = (Vector3.new(myRoot.Position.X, 0, myRoot.Position.Z) - Vector3.new(enemyRoot.Position.X, 0, enemyRoot.Position.Z)).Magnitude
    if dist > State.parryDistance then return end

    if not isNpc and not isAttackerFacingMe(enemyRoot, myRoot) then
        return
    end

    if not isNpc and not canDash and not State.autoFace and dist > 14 and not isFacingTarget(myRoot, enemyRoot, -0.2) then
        return
    end

    if State.autoEquip and myChar:GetAttribute("Equip") ~= true then
        ensureEquipped()
    end

    local style = (attackData and attackData.baseStyle ~= "default" and attackData.baseStyle) or getEnemyStyle(character, "basic")
    local styleKey = resolveStyleKey(style)

    if State.autoFace then
        faceTarget(enemyRoot, 0.45)
    end

    if isHeavy then
        recordM2Cooldown(character, style)
        local hitboxDelay = attackData and attackData.fallbackDelay
        if not hitboxDelay or typeof(hitboxDelay) ~= "number" then
            pcall(function()
                hitboxDelay = CombatConfig.GetStyleM2HitboxDelay(style)
            end)
        end
        hitboxDelay = hitboxDelay or 0.38
        local trackSpeed = math.max(math.abs(track.Speed), 0.05)
        local effectiveHitbox = (hitboxDelay / trackSpeed)
        local pingLead = (isNpc and 0) or (State.pingComp and (getLivePing() * 0.5) or 0)
        local dodgeDelay = math.max(0, effectiveHitbox - 0.22 - pingLead)

        local isStyleAllowed = (State.styleToggles[styleKey] == true)
        local canDashStyle = canDash and isStyleAllowed

        if styleKey == "boxing" then
            if State.boxingHold then
                handleBoxingHold(character, track)
                return
            elseif canDashStyle then
                triggerDodge("boxing", enemyRoot, dodgeDelay)
                return
            end
        end

        if canDashStyle then
            triggerDodge(styleKey, enemyRoot, dodgeDelay)
            return
        end
    end

    local canParry = (isNpc and State.npcParry) or (not isNpc and State.autoParry)
    if not canParry then return end

    local baseDelay = attackData and attackData.fallbackDelay or 0.30
    if isHeavy then
        pcall(function()
            baseDelay = CombatConfig.GetStyleM2HitboxDelay(style)
        end)
        baseDelay = baseDelay or 0.40
    else
        local combo = (attackData and attackData.combo) or tonumber(lowerName:match("^(%d)")) or 1
        pcall(function()
            baseDelay = CombatConfig.GetScaledStyleM1HitboxDelay(style, combo, 1)
        end)
        baseDelay = baseDelay or 0.30
    end

    local heightMult = 1
    pcall(function()
        if CombatUtils and CombatUtils.GetCharacterHeight and CombatUtils.GetAttackSpeedMultiplier then
            local h = CombatUtils.GetCharacterHeight(character)
            if h then
                heightMult = CombatUtils.GetAttackSpeedMultiplier(h) or 1
            end
        end
    end)

    local trackSpeed = math.max(math.abs(track.Speed), 0.05)
    local effectiveDelay = (baseDelay / trackSpeed) * heightMult

    local lead = State.parryLead
    if not isNpc and State.pingComp then
        lead = lead + (getLivePing() * 0.5)
    end

    local parryDelay = math.max(0, effectiveDelay - lead)
    local pulseHold = isHeavy and 0.32 or 0.22

    if parryDelay <= 0.03 then
        if State.autoFace and not isNpc then
            faceTarget(enemyRoot, 0.3)
        end
        applyParryPulse(pulseHold)
    else
        task.delay(parryDelay, function()
            local canParryDelayed = (isNpc and State.npcParry) or (not isNpc and State.autoParry)
            if State.unloading or not canParryDelayed then return end
            myChar = LocalPlayer.Character
            myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
            enemyRoot = character and character:FindFirstChild("HumanoidRootPart")
            if myRoot and enemyRoot then
                local currentDist = (Vector3.new(myRoot.Position.X, 0, myRoot.Position.Z) - Vector3.new(enemyRoot.Position.X, 0, enemyRoot.Position.Z)).Magnitude
                if currentDist <= State.parryDistance then
                    if State.autoFace then
                        faceTarget(enemyRoot, 0.3)
                    end
                    applyParryPulse(pulseHold)
                end
            end
        end)
    end
end

