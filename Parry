local function getLivePing()
    local ping = 0
    pcall(function()
        ping = Stats.Network.ServerStatsItem["Data Ping"]:GetValue() / 1000
    end)
    if ping <= 0 then
        pcall(function()
            ping = LocalPlayer:GetNetworkPing()
        end)
    end
    return math.clamp(ping or 0, 0, 0.35)
end

