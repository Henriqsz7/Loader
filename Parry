local function serverHop(emptyOnly)
    if State.hopping then return end
    State.hopping = true
    Library:Notify("Searching for server...", 3)
    task.spawn(function()
        local ok, data = pcall(function()
            local res = game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100")
            return HttpService:JSONDecode(res)
        end)
        if ok and data and data.data then
            local targetServer
            if emptyOnly then
                local lowest = math.huge
                for _, s in ipairs(data.data) do
                    if s.id ~= game.JobId and s.playing < lowest and s.playing < s.maxPlayers then
                        lowest = s.playing
                        targetServer = s
                    end
                end
            else
                local pool = {}
                for _, s in ipairs(data.data) do
                    if s.id ~= game.JobId and s.playing < s.maxPlayers then
                        table.insert(pool, s)
                    end
                end
                if #pool > 0 then
                    targetServer = pool[math.random(1, #pool)]
                end
            end
            if targetServer then
                pcall(function()
                    TeleportService:TeleportToPlaceInstance(game.PlaceId, targetServer.id, LocalPlayer)
                end)
            else
                Library:Notify("No server found.", 3)
            end
        else
            Library:Notify("Server request failed.", 3)
        end
        task.delay(5, function() State.hopping = false end)
    end)
end

local function unloadScript()
    if State.unloading then return end
    State.unloading = true
    stopAutoFacing()
    toggleNoCooldown(false)

    local myChar = LocalPlayer.Character
    if myChar and myChar:GetAttribute("Blocking") == true then
        pcall(Block.Unblock)
    end

    for _, c in ipairs(State.connections) do
        pcall(c.Disconnect, c)
    end
    table.clear(State.connections)

    for _, o in ipairs(State.createdObjects) do
        pcall(o.Destroy, o)
    end
    table.clear(State.createdObjects)

    clearAllPlayerInfoGuis()
    _G.VenenoState = nil
    Library:Unload()
end

