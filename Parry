    autoMemory = false,
}

local originalLighting = {
    GlobalShadows = Lighting.GlobalShadows,
    FogEnd = Lighting.FogEnd,
    Brightness = Lighting.Brightness,
    ClockTime = Lighting.ClockTime,
    OutdoorAmbient = Lighting.OutdoorAmbient,
}

local function applyFPSCap(v)
    local fn = setfpscap or (getgenv and getgenv().setfpscap)
    if fn then
        pcall(fn, (v == 0 or v >= 360) and 0 or v)
    end
end

applyFPSCap(240)

local function optimizeInstance(inst)
    if BoostState.noShadows or BoostState.potato then
        if inst:IsA("BasePart") then
            inst.CastShadow = false
        end
    end

    if BoostState.potato then
        if inst:IsA("BasePart") and not inst:IsDescendantOf(LocalPlayer.Character) then
            inst.Material = Enum.Material.SmoothPlastic
            inst.Reflectance = 0
        end
    end

    if BoostState.noTextures then
        if inst:IsA("Decal") or inst:IsA("Texture") then
            inst.Transparency = 1
        end
    end

    if BoostState.noParticles then
        if inst:IsA("ParticleEmitter") or inst:IsA("Trail") or inst:IsA("Smoke") or inst:IsA("Fire") or inst:IsA("Sparkles") or inst:IsA("Beam") or inst:IsA("Highlight") then
            inst.Enabled = false
        end
    end

    if BoostState.noLights then
        if inst:IsA("PointLight") or inst:IsA("SpotLight") or inst:IsA("SurfaceLight") then
            inst.Enabled = false
        end
    end

    if BoostState.noSounds then
        if inst:IsA("Sound") and inst.Looped then
            local n = inst.Name:lower()
            if not n:find("hit") and not n:find("punch") and not n:find("swing") and not n:find("parry") and not n:find("block") then
                inst.Volume = 0
            end
        end
    end

    if BoostState.noLeaves then
        local name = string.lower(inst.Name)
        if string.find(name, "leaf") or string.find(name, "leaves") or string.find(name, "tree") or string.find(name, "puddle") or string.find(name, "bush") or string.find(name, "grass") then
            if inst:IsA("BasePart") then
                inst.Transparency = 1
                inst.CanCollide = false
            elseif inst:IsA("ParticleEmitter") or inst:IsA("Decal") or inst:IsA("Texture") then
                inst.Enabled = false
            end
        end
    end
end

trackConn(workspace.DescendantAdded:Connect(function(inst)
    if BoostState.potato or BoostState.noTextures or BoostState.noParticles or BoostState.noShadows or BoostState.noLeaves or BoostState.noLights or BoostState.noSounds then
        pcall(optimizeInstance, inst)
    end
end))

task.spawn(function()
    while true do
        task.wait(60)
        if State.unloading then break end
        if BoostState.autoMemory then
            pcall(function()
                collectgarbage("collect")
            end)
        end
    end
end)

